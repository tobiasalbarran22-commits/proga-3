# Valores para `npm run dev`. No contienen secretos, por eso se versionan.
# Para usar el backend real, creá .env.development.local con tus valores:
# lo que pongas ahí pisa lo de este archivo.

# URL del backend. Con el backend simulado apunta a la propia app.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/mock

# Habilita el backend simulado (app/api/mock). Poner en false al usar el real.
MOCK_API_HABILITADO=true
